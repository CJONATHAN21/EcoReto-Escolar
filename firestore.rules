rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function logged() { return request.auth != null; }
  function verified() { return logged() && request.auth.token.email_verified == true; }
  function localNow() { return request.time - duration.value(5, 'h'); }
  function teacher() {
   return verified() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
    && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'docente';
  }
  match /usuarios/{uid} {
   allow create: if logged() && request.auth.uid == uid
    && request.resource.data.keys().hasOnly(['nombre','correo','rol','creadoEn'])
    && request.resource.data.rol == 'alumno'
    && request.resource.data.correo == request.auth.token.email;
   allow read: if verified() && (request.auth.uid == uid || teacher());
   allow list: if teacher();
   allow update: if teacher() || (verified() && request.auth.uid == uid
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre']));
   allow delete: if false;
  }
  match /recolecciones/{id} {
   function valid() {
    return request.resource.data.keys().hasOnly(['alumnoId','fecha','mes','semana','plastico','papel','carton','metal','otros','observaciones','registradoPor','actualizadoEn','anio','mesNumero','dia'])
     && request.resource.data.keys().hasAll(['alumnoId','fecha','mes','semana','plastico','papel','carton','metal','otros','observaciones','registradoPor','actualizadoEn','anio','mesNumero','dia'])
     && request.resource.data.alumnoId is string
     && request.resource.data.fecha is string && request.resource.data.fecha.size() == 10
     && request.resource.data.mes is string && request.resource.data.mes.size() == 7
     && request.resource.data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
     && request.resource.data.mes == request.resource.data.fecha.substring(0,7)
     && request.resource.data.anio is int && request.resource.data.anio == localNow().year()
     && request.resource.data.mesNumero is int && request.resource.data.mesNumero == localNow().month()
     && request.resource.data.dia is int && request.resource.data.dia >= 1 && request.resource.data.dia <= localNow().day()
     && request.resource.data.semana is int && request.resource.data.semana >= 1 && request.resource.data.semana <= 4
     && request.resource.data.semana == (localNow().day() <= 7 ? 1 : localNow().day() <= 14 ? 2 : localNow().day() <= 21 ? 3 : 4)
     && request.resource.data.dia >= (request.resource.data.semana - 1) * 7 + 1
     && (request.resource.data.semana == 4 || request.resource.data.dia <= request.resource.data.semana * 7)
     && request.resource.data.plastico is int && request.resource.data.plastico >= 0 && request.resource.data.plastico <= 10000
     && request.resource.data.papel is int && request.resource.data.papel >= 0 && request.resource.data.papel <= 10000
     && request.resource.data.carton is int && request.resource.data.carton >= 0 && request.resource.data.carton <= 10000
     && request.resource.data.metal is int && request.resource.data.metal >= 0 && request.resource.data.metal <= 10000
     && request.resource.data.otros is int && request.resource.data.otros >= 0 && request.resource.data.otros <= 10000
     && request.resource.data.observaciones is string && request.resource.data.observaciones.size() <= 500
     && request.resource.data.registradoPor == request.auth.uid
     && request.resource.data.actualizadoEn == request.time
     && id == request.resource.data.alumnoId + '_' + request.resource.data.fecha;
   }
   allow get, list: if verified() && (teacher() || resource.data.alumnoId == request.auth.uid);
   allow create: if teacher() && valid()
    && exists(/databases/$(database)/documents/usuarios/$(request.resource.data.alumnoId))
    && get(/databases/$(database)/documents/usuarios/$(request.resource.data.alumnoId)).data.rol == 'alumno';
   allow update: if teacher() && valid()
    && request.resource.data.alumnoId == resource.data.alumnoId
    && request.resource.data.fecha == resource.data.fecha
    && request.resource.data.anio == resource.data.anio
    && request.resource.data.mesNumero == resource.data.mesNumero
    && request.resource.data.dia == resource.data.dia;
   allow delete: if false;
  }
  // EcoArte: solo docentes publican plantillas; alumnos registran sus realizaciones.
  match /manualidades/{id} {
    function validProject() {
      return request.resource.data.keys().hasOnly(['name','description','image','materials','steps','pdf','creadoPor','creadoEn'])
        && request.resource.data.keys().hasAll(['name','description','image','materials','steps','pdf','creadoPor','creadoEn'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.description is string && request.resource.data.description.size() > 0 && request.resource.data.description.size() <= 600
        && request.resource.data.image is string && request.resource.data.image.matches('^https://res.cloudinary.com/hohksfnm/image/upload/.*')
        && request.resource.data.materials is list && request.resource.data.materials.size() > 0 && request.resource.data.materials.size() <= 20
        && request.resource.data.steps is list && request.resource.data.steps.size() > 0 && request.resource.data.steps.size() <= 20
        && request.resource.data.pdf is string && request.resource.data.pdf.size() <= 500
        && request.resource.data.creadoPor == request.auth.uid && request.resource.data.creadoEn == request.time;
    }
    allow read: if true;
    allow create: if teacher() && validProject();
    allow update, delete: if false;
  }
  match /manualidades_realizadas/{id} {
    function isStudent() {
      return verified() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'alumno';
    }
    function validRecord() {
      return request.resource.data.keys().hasOnly(['alumnoId','proyectoId','proyectoNombre','productos','materiales','estado','observacion','creadoEn','actualizadoEn'])
        && request.resource.data.keys().hasAll(['alumnoId','proyectoId','proyectoNombre','productos','materiales','estado','observacion','creadoEn','actualizadoEn'])
        && request.resource.data.alumnoId == request.auth.uid
        && request.resource.data.proyectoId is string
        && (request.resource.data.proyectoId.matches('^base_[0-4]$') || exists(/databases/$(database)/documents/manualidades/$(request.resource.data.proyectoId)))
        && request.resource.data.proyectoNombre is string && request.resource.data.proyectoNombre.size() > 0 && request.resource.data.proyectoNombre.size() <= 100
        && request.resource.data.productos is int && request.resource.data.productos > 0 && request.resource.data.productos <= 1000
        && request.resource.data.materiales is list && request.resource.data.materiales.size() > 0 && request.resource.data.materiales.size() <= 20
        && request.resource.data.estado == 'pendiente' && request.resource.data.observacion == ''
        && request.resource.data.creadoEn == request.time && request.resource.data.actualizadoEn == request.time;
    }
    allow get, list: if verified() && (teacher() || resource.data.alumnoId == request.auth.uid);
    allow create: if isStudent() && validRecord();
    allow update: if teacher() && resource.data.estado == 'pendiente'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado','observacion','revisadoPor','revisadoEn','actualizadoEn'])
      && request.resource.data.estado in ['aprobado','observado']
      && request.resource.data.observacion is string && request.resource.data.observacion.size() <= 500
      && (request.resource.data.estado == 'aprobado' || request.resource.data.observacion.size() > 0)
      && request.resource.data.revisadoPor == request.auth.uid
      && request.resource.data.revisadoEn == request.time && request.resource.data.actualizadoEn == request.time;
    allow delete: if false;
  }
  match /{document=**} { allow read, write: if false; }
 }
}
